{
  "expo": {
    "name": "agilo-pos",
    "slug": "agilo-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agilopos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.tomhoward.agilopos",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.agilo.pos"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 233,
          "resizeMode": "contain",
          "backgroundColor": "#f4faff"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/noto-sans/400Regular/NotoSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/noto-sans/400Regular_Italic/NotoSans_400Regular_Italic.ttf",
            "node_modules/@expo-google-fonts/noto-sans/700Bold/NotoSans_700Bold.ttf",
            "node_modules/@expo-google-fonts/noto-sans/700Bold_Italic/NotoSans_700Bold_Italic.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "./plugins/withStripeTerminal.js",
        {
          "merchantDisplayName": "Agilo POS",
          "locationWhenInUsePermission": "Location access is required to accept payments.",
          "bluetoothAlwaysUsagePermission": "This app uses Bluetooth to connect to supported card readers.",
          "bluetoothPeripheralPermission": "Connecting to supported card readers requires Bluetooth access.",
          "nfcUsageDescription": "Agilo POS needs access to NFC to accept contactless payments"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c44b68b-5c32-4031-a160-d315e6c399d4"
      },
      "stripeTerminal": {
        "merchantDisplayName": "Agilo POS",
        "enableSimulatedReaders": true
      }
    },
    "owner": "agilo-com",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/2c44b68b-5c32-4031-a160-d315e6c399d4"
    }
  }
}
